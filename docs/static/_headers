# Response headers for docs.skyhitz.io (Cloudflare Pages reads this file from
# the build output: https://developers.cloudflare.com/pages/configuration/headers/).
# Pages already sends X-Content-Type-Options: nosniff and a Referrer-Policy on
# every response; these add the rest.

# Every page: nobody may frame the docs, plugins and <base> tricks are off,
# and browsers use HTTPS for this host from now on. The policy says nothing
# about scripts on purpose: Docusaurus needs its inline theme script, and
# Cloudflare may add scripts of its own to a page.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=(), display-capture=(), browsing-topics=()

# Docusaurus names every script and stylesheet after a hash of its contents,
# so a file under /assets/ never changes: browsers may keep it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Plain files for programs: the right type and charset, so "√" reads correctly.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8
/*.md
  Content-Type: text/markdown; charset=utf-8
